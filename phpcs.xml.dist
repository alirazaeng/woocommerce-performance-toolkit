<?xml version="1.0"?>
<ruleset name="WooCommerce Performance Toolkit">
	<description>PHP_CodeSniffer rules for the WooCommerce Performance Toolkit.</description>

	<file>php</file>

	<exclude-pattern>vendor/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="arwpt"/>
				<element value="ARWPT"/>
			</property>
		</properties>
	</rule>
</ruleset>
